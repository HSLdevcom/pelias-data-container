# Copy this file to .env.local (or similar) and fill in real values.
# .env* is git-ignored, so your local copy with secrets will never be committed.
#
# Load it into your shell before building/testing locally, e.g.:
#   set -a; source .env.local; set +a

# Needed for loading NLSFI (maanmittauslaitos) place data
MMLAPIKEY=

# Authentication for Digitransit GTFS/routing-data sources
API_SUBSCRIPTION_QUERY_PARAMETER_NAME=
API_SUBSCRIPTION_TOKEN=

# Dockerhub credentials, only needed if you intend to push/deploy images
DOCKER_USER=
DOCKER_AUTH=

# Optional: prod or dev, default dev. Controls Digitransit API endpoints used
# and data image tagging (dev->latest, prod->prod)
BUILDER_TYPE=dev

# Optional: name of an additional GTFS service/router to load alongside
# finland/waltti/hsl/varely
EXTRA_SRC=

# Optional: json array for adding additional key-value pairs to remove
# undesired content, e.g. '[{ "name": "some ugly word" }]'
OSM_VENUE_FILTERS=
OSM_ADDRESS_FILTERS=

# Optional: regression limit, as %, defaults to 2%
THRESHOLD=

# Optional: for posting build status messages to Slack
SLACK_CHANNEL_ID=
SLACK_ACCESS_TOKEN=
