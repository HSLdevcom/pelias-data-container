ARG DOCKER_TAG=latest
FROM hsldevcom/pelias-data-container-base:$DOCKER_TAG

ARG MMLAPIKEY
ARG OSM_VENUE_FILTERS
ARG OSM_ADDRESS_FILTERS
ARG BUILDER_TYPE
ARG API_SUBSCRIPTION_QUERY_PARAMETER_NAME
ARG API_SUBSCRIPTION_TOKEN
ARG EXTRA_SRC

# Dockerfile which loads and indexes new data into empty data container image
LABEL maintainer="Reittiopas version: 0.1"

# Optional backup storage tokens are mounted as BuildKit secrets so that they do not end up in the image history
RUN --mount=type=secret,id=BLOB_READ_SAS --mount=type=secret,id=BLOB_WRITE_SAS \
    /bin/bash -c "source /mnt/tools/scripts/getdata.sh"

EXPOSE 9200

CMD /etc/init.d/elasticsearch start && sleep 10000d
